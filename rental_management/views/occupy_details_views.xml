<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="occupy_details_form_view" model="ir.ui.view">
            <field name="name">occupy.details.form</field>
            <field name="model">occupy.details</field>
            <field name="arch" type="xml">
                <form string="Occupant Accommodation Contract">
                    <header>
                        <button name="action_set_running"
                                string="Activate"
                                type="object"
                                class="btn btn-success"
                                invisible="state != 'draft'"
                                groups="rental_management.property_rental_manager,rental_management.property_rental_officer"/>
                        <button name="action_close_contract"
                                string="Vacate"
                                type="object"
                                class="btn btn-danger"
                                invisible="state != 'running'"/>
                        <button name="action_cancel_contract"
                                string="Cancel"
                                type="object"
                                class="btn btn-warning"
                                invisible="state not in ['draft', 'running']"/>
                        <button string="Shift"
                                type="action"
                                name="%(shift_occupy_wizard_action)d"
                                class="btn btn-warning"
                                icon="fa-exchange"
                                invisible="state != 'running'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,running,cancel,close,expire"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="occupy_seq" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="partner_type" widget="radio"
                                       options="{'horizontal': true}"/>
                                <field name="property_id"
                                       domain="[('stage', '=', 'available'), ('sale_lease', 'in', ['employee_family', 'bachelor'])]"
                                       options="{'no_create': True}"/>
                                <field name="sale_lease" readonly="1"/>
                                <field name="bed_id" readonly="1"
                                       invisible="sale_lease != 'bachelor'"
                                       options="{'no_open': True}"/>
                                <field name="utility_water_account_no"/>
                                <field name="utility_electricity_account_no"/>
                            </group>
                            <group string="Occupant">
                                <field name="occupant_id"
                                       required="1"
                                       options="{'no_create': True}"/>
                                <field name="occupant_name"/>
                                <field name="occupant_phone" widget="phone"/>
                                <field name="occupant_email" widget="email"/>
                            </group>
                        </group>

                        <!-- Employee details (shown if occupant is linked to employee) -->
                        <group string="Employee Details" invisible="not employee_id">
                            <field name="employee_id" readonly="1"/>
                            <field name="employee_code"/>
                            <field name="department_id"/>
                        </group>

                        <group string="Contract Period">
                            <group>
                                <field name="start_date"/>
                                <field name="expected_end_date"/>
                            </group>
                            <group>
                                <field name="terminate_date" readonly="1"/>
                                <field name="days_left" readonly="1"/>
                            </group>
                        </group>


                        <group>
                            <field name="responsible_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group>
                            <field name="note" placeholder="Add a note..."/>
                        </group>
                        <field name="is_material_handover_applicable" invisible="1" />
                        <group string="Bed List" invisible="not is_material_handover_applicable">
                            <field name="material_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="material_id" options="{'no_create': True}" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="note" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="occupy_details_list_view" model="ir.ui.view">
            <field name="name">occupy.details.list</field>
            <field name="model">occupy.details</field>
            <field name="arch" type="xml">
                <list string="Occupant Accommodation Contracts"
                      decoration-muted="state == 'cancel'"
                      decoration-success="state == 'running'"
                      decoration-danger="state == 'expire'">
                    <field name="occupy_seq"/>
                    <field name="partner_type"/>
                    <field name="occupant_id"/>
                    <field name="employee_code" optional="show"/>
                    <field name="property_id"/>
                    <field name="utility_water_account_no" optional="hide"/>
                    <field name="utility_electricity_account_no" optional="hide"/>
                    <field name="start_date"/>
                    <field name="expected_end_date"/>
                    <field name="terminate_date"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'running'"
                           decoration-warning="state == 'close'"
                           decoration-danger="state == 'expire'"
                           decoration-muted="state == 'cancel'"/>
                    <field name="days_left"/>
                    <field name="note" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="occupy_details_search_view" model="ir.ui.view">
            <field name="name">occupy.details.search</field>
            <field name="model">occupy.details</field>
            <field name="arch" type="xml">
                <search string="Occupant Accommodation Contracts">
                    <field name="occupy_seq"/>
                    <field name="occupant_id"/>
                    <field name="property_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                    <filter string="Expired" name="expire" domain="[('state', '=', 'expire')]"/>
                    <filter string="Closed" name="close" domain="[('state', '=', 'close')]"/>
                    <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]"/>
                    <group>
                        <filter string="Status" name="group_by_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Occupant" name="group_by_occupant"
                                context="{'group_by': 'occupant_id'}"/>
                        <filter string="Property" name="group_by_property"
                                context="{'group_by': 'property_id'}"/>
                        <filter string="Type" name="group_by_partner_type"
                                context="{'group_by': 'partner_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="occupy_details_action" model="ir.actions.act_window">
            <field name="name">Occupy Contracts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">occupy.details</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="occupy_details_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first occupant accommodation contract
                </p>
            </field>
        </record>
    </data>
</odoo>
