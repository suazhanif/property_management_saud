<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_rent_period_date" model="ir.ui.view">
        <field name="name">account.move.form.rent.period.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="rent_period_date" invisible="not rent_period_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_list_rent_period_date" model="ir.ui.view">
        <field name="name">account.move.list.rent.period.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="rent_period_date" optional="hide"/>
            </field>
        </field>
    </record>

    <data noupdate="1">
        <record id="ir_config_invoice_date_today" model="ir.config_parameter">
            <field name="key">rental_management.invoice_date_today</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>