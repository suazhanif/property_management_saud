<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="property_lead_inherit_form_view" model="ir.ui.view">
            <field name="name">property.lead.inherit.form.view</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form" />
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']">
                    <button
                        name="action_open_property_details"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-building-o"
                    >
                        <field name="available_property_count" widget="statinfo" string="Properties" />
                    </button>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Property Details">
                        <group>
                            <group>
                                <field name="property_type" widget="radio"
                                    options="{'horizontal': true}" />
                                <field name="sale_lease" widget="radio"
                                    options="{'horizontal': true}" />
                                <field name="currency_id" invisible="1" />
                                <field name="ask_price" invisible="sale_lease != 'for_sale'" />
                            </group>
                            <group>
                                <field name="furnishing_id"
                                    options="{'no_quick_create':True,'no_create_edit':True}"
                                    invisible="property_type in ['land','industrial']" />
                                <label for="unit_type" class="mt-1" string="BHK"
                                    invisible="property_type in ['land','industrial','commercial']" />
                                <div name="unit_type"
                                    invisible="property_type in ['land','industrial','commercial']">
                                    <field name="unit_type" class="oe_inline"
                                        force_save="1" /> BHK </div>
                            </group>
                            <!-- <group>
                                <field name="property_id"
                                    options="{'no_quick_create':True,'no_create_edit':True}" />
                                <label for="price" string="Rent"
                                    invisible="sale_lease != 'for_tenancy'" />
                                <div invisible="sale_lease != 'for_tenancy'">
                                    <field name="price" required="1" class="oe_inline" />
                                </div>
                                <label for="price" string="Sale Price"
                                    invisible="sale_lease != 'for_sale'" />
                                <div invisible="sale_lease != 'for_sale'">
                                    <field name="price" required="1" class="oe_inline" />
                                </div>
                            </group> -->
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="property_inquiry_action" model="ir.actions.act_window">
            <field name="name">Opportunity</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.lead</field>
            <field name="domain">[('type','=','opportunity')]</field>
            <field name="context">{'default_type':'opportunity'}</field>
            <field name="view_mode">list,form,kanban,activity</field>
        </record>
    </data>
</odoo>