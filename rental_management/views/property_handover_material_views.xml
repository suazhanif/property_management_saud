<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="property_handover_material_view_list" model="ir.ui.view">
            <field name="name">property.handover.material.list</field>
            <field name="model">property.handover.material</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="replacement_years" />
                    <field name="note" />
                    <field name="active" widget="boolean_toggle" />
                </list>
            </field>
        </record>

        <record id="property_handover_material_view_form" model="ir.ui.view">
            <field name="name">property.handover.material.form</field>
            <field name="model">property.handover.material</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="replacement_years" />
                            <field name="note" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="property_handover_material_action" model="ir.actions.act_window">
            <field name="name">Handover Materials</field>
            <field name="res_model">property.handover.material</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>