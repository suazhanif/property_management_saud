<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_employee_grade_form_view" model="ir.ui.view">
            <field name="name">hr.employee.grade.form.view</field>
            <field name="model">hr.employee.grade</field>
            <field name="arch" type="xml">
                <form duplicate="false">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" required="1" placeholder="Name" />
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_employee_grade_list_view" model="ir.ui.view">
            <field name="name">hr.employee.grade.list.view</field>
            <field name="model">hr.employee.grade</field>
            <field name="arch" type="xml">
                <list duplicate="false">
                    <field name="name" />
                </list>
            </field>
        </record>
        <record id="hr_employee_grade_action" model="ir.actions.act_window">
            <field name="name">Employee Grades</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.employee.grade</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>