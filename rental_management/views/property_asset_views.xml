<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Categories ===================== -->
    <record id="property_asset_category_view_list" model="ir.ui.view">
        <field name="name">property.asset.category.list</field>
        <field name="model">property.asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="property_asset_category_action" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">property.asset.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== Templates ===================== -->
    <record id="property_asset_template_view_form" model="ir.ui.view">
        <field name="name">property.asset.template.form</field>
        <field name="model">property.asset.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_properties" type="object"
                                class="oe_stat_button" icon="fa-home">
                            <field name="property_count" string="Properties" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 2BHK Standard"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_subtype_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assets" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show" options="{'no_create': True}"/>
                                    <field name="brand" optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="property_asset_template_view_list" model="ir.ui.view">
        <field name="name">property.asset.template.list</field>
        <field name="model">property.asset.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_subtype_id"/>
                <field name="line_count"/>
                <field name="property_count"/>
            </list>
        </field>
    </record>
    <record id="property_asset_template_action" model="ir.actions.act_window">
        <field name="name">Asset Templates</field>
        <field name="res_model">property.asset.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== Unit Assets ===================== -->
    <record id="property_unit_asset_view_list" model="ir.ui.view">
        <field name="name">property.unit.asset.list</field>
        <field name="model">property.unit.asset</field>
        <field name="arch" type="xml">
            <list decoration-danger="condition in ('damaged','missing')"
                  decoration-muted="not active">
                <field name="property_id"/>
                <field name="subproject_id" optional="show"/>
                <field name="property_project_id" optional="hide"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand" optional="show"/>
                <field name="serial_no" optional="show"/>
                <field name="quantity" sum="Total Qty"/>
                <field name="uom_id" optional="hide"/>
                <field name="condition" widget="badge"
                       decoration-success="condition in ('new','good')"
                       decoration-warning="condition == 'fair'"
                       decoration-danger="condition in ('damaged','missing')"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="value" sum="Total Value" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="property_unit_asset_view_form" model="ir.ui.view">
        <field name="name">property.unit.asset.form</field>
        <field name="model">property.unit.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Split AC 1.5 Ton"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="subproject_id"/>
                            <field name="property_project_id"/>
                            <field name="template_id" invisible="not template_id"/>
                        </group>
                        <group string="Details">
                            <field name="category_id" options="{'no_create': True}"/>
                            <label for="quantity"/>
                            <div class="o_row">
                                <field name="quantity"/>
                                <field name="uom_id" options="{'no_create': True}"/>
                            </div>
                            <field name="brand"/>
                            <field name="model_no"/>
                            <field name="serial_no"/>
                            <field name="condition"/>
                        </group>
                        <group string="Value &amp; Warranty">
                            <field name="currency_id" invisible="1"/>
                            <field name="value"/>
                            <field name="purchase_date"/>
                            <field name="warranty_end_date"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="property_unit_asset_view_search" model="ir.ui.view">
        <field name="name">property.unit.asset.search</field>
        <field name="model">property.unit.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_no"/>
                <field name="property_id"/>
                <field name="subproject_id"/>
                <field name="property_project_id"/>
                <field name="category_id"/>
                <filter string="Damaged / Missing" name="problem"
                        domain="[('condition', 'in', ('damaged', 'missing'))]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Compound" name="group_compound" context="{'group_by': 'property_project_id'}"/>
                    <filter string="Building" name="group_building" context="{'group_by': 'subproject_id'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="property_unit_asset_view_pivot" model="ir.ui.view">
        <field name="name">property.unit.asset.pivot</field>
        <field name="model">property.unit.asset</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="subproject_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="property_unit_asset_action" model="ir.actions.act_window">
        <field name="name">Unit Assets</field>
        <field name="res_model">property.unit.asset</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_group_property': 1}</field>
    </record>

    <!-- ===================== Property form ===================== -->
    <record id="property_details_form_asset_inherit" model="ir.ui.view">
        <field name="name">property.details.form.asset.inherit</field>
        <field name="model">property.details</field>
        <field name="inherit_id" ref="rental_management.property_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                    <field name="asset_count" string="Assets" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook/page[@name='pricing_details']" position="after">
                <page string="Assets" name="assets">
                    <group>
                        <group>
                            <label for="asset_template_id"/>
                            <div class="o_row">
                                <field name="asset_template_id" options="{'no_create': True}"/>
                                <button name="action_apply_asset_template" type="object"
                                        string="Apply Template" icon="fa-download"
                                        class="btn btn-secondary btn-sm"
                                        invisible="not asset_template_id"/>
                            </div>
                        </group>
                        <group>
                            <button name="%(rental_management.action_report_property_assets)d"
                                    type="action" string="Print Asset Register"
                                    icon="fa-print" class="btn btn-secondary btn-sm"/>
                        </group>
                    </group>
                    <field name="asset_ids" context="{'default_property_id': id}">
                        <list editable="bottom"
                              decoration-danger="condition in ('damaged','missing')">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="brand" optional="show"/>
                            <field name="model_no" optional="hide"/>
                            <field name="serial_no" optional="show"/>
                            <field name="quantity" sum="Total"/>
                            <field name="uom_id" optional="hide" options="{'no_create': True}"/>
                            <field name="condition"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="value" optional="hide" sum="Total"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===================== Menus ===================== -->
    <menuitem id="menu_property_unit_asset" name="Unit Assets"
              parent="rental_management.menu_property_project_subproject"
              action="property_unit_asset_action" sequence="5"
              groups="rental_management.property_rental_manager,rental_management.property_rental_officer"/>
    <menuitem id="menu_property_asset_template" name="Asset Templates"
              parent="rental_management.menu_configuration_property"
              action="property_asset_template_action" sequence="9"
              groups="rental_management.property_rental_manager,rental_management.property_rental_officer"/>
    <menuitem id="menu_property_asset_category" name="Asset Categories"
              parent="rental_management.menu_configuration_property"
              action="property_asset_category_action" sequence="10"
              groups="rental_management.property_rental_manager,rental_management.property_rental_officer"/>
</odoo>