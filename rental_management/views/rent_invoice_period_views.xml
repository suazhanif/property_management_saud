<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract > Rent Installments: unit + From / To -->
    <record id="tenancy_details_form_rent_period_inherit" model="ir.ui.view">
        <field name="name">tenancy.details.form.rent.period.inherit</field>
        <field name="model">tenancy.details</field>
        <field name="inherit_id" ref="rental_management.tenancy_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rent_invoice_ids']/list/field[@name='invoice_date']" position="after">
                <field name="period_from" optional="show"/>
                <field name="period_to" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Rent Invoices menu list -->
    <record id="rent_invoice_list_view_period_inherit" model="ir.ui.view">
        <field name="name">rent.invoice.list.period.inherit</field>
        <field name="model">rent.invoice</field>
        <field name="inherit_id" ref="rental_management.rent_invoice_list_view"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="unit_label" optional="show"/>
                <field name="period_from" optional="show"/>
                <field name="period_to" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Invoice form: unit no. and period -->
    <record id="view_move_form_rent_period_inherit" model="ir.ui.view">
        <field name="name">account.move.form.rent.period.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="tenancy_unit_label" invisible="not tenancy_unit_label"/>
                <label for="rent_period_from" string="Period" invisible="not rent_period_from"/>
                <div class="o_row" invisible="not rent_period_from">
                    <field name="rent_period_from" class="oe_inline"/>
                    <span>to</span>
                    <field name="rent_period_to" class="oe_inline"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="rent_period_label" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>