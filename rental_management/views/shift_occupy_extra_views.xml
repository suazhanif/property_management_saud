<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="occupy_details_form_view_shift_info" model="ir.ui.view">
        <field name="name">occupy.details.form.shift.info</field>
        <field name="model">occupy.details</field>
        <field name="inherit_id" ref="rental_management.occupy_details_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <field name="shift_out_id" invisible="1" />
                <field name="shift_in_id" invisible="1" />
                <div class="alert alert-warning mb-2" role="alert" invisible="not shift_out_id">
                    <strong>Shifted out</strong> on
                    <field name="shift_out_date" readonly="1" class="oe_inline" />
                    to <field name="shifted_to_property_id" readonly="1" class="oe_inline" />
                    (new contract <field name="shifted_to_occupy_id" readonly="1" class="oe_inline" />,
                    shift <field name="shift_out_id" readonly="1" class="oe_inline" />).
                    <div>Reason: <field name="shift_out_reason" readonly="1" class="oe_inline" /></div>
                </div>
                <div class="alert alert-info mb-2" role="alert" invisible="not shift_in_id">
                    <strong>Shifted in</strong> from contract
                    <field name="shifted_from_occupy_id" readonly="1" class="oe_inline" />
                    (shift <field name="shift_in_id" readonly="1" class="oe_inline" />).
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_shift_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.shift.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rental_management.res_config_settings_view_form_rental" />
        <field name="arch" type="xml">
            <app name="rental_management" position="inside">
                <block title="Accommodation Shift" name="shift_approval">
                    <setting help="New shifts require a Rental Manager's approval before they can be executed. Managers can still switch it off per shift.">
                        <field name="shift_approval_required" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>