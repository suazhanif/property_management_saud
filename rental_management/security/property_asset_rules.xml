<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_property_unit_asset_assigned" model="ir.rule">
            <field name="name">Property Asset: Officer Sees Assigned Properties Only</field>
            <field name="model_id" ref="rental_management.model_property_unit_asset"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('property_id.user_ids', 'in', user.id),
                ('property_id.subproject_id.user_ids', 'in', user.id),
                ('property_id.subproject_id.property_project_id.user_ids', 'in', user.id),
                ('property_id.property_project_id.user_ids', 'in', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('rental_management.property_rental_officer'))]"/>
        </record>
        <record id="rule_property_unit_asset_company" model="ir.rule">
            <field name="name">Property Asset: Company</field>
            <field name="model_id" ref="rental_management.model_property_unit_asset"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_property_unit_asset_custody_assigned" model="ir.rule">
            <field name="name">Asset Custody: Officer Sees Assigned Properties Only</field>
            <field name="model_id" ref="rental_management.model_property_unit_asset_custody"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('property_id.user_ids', 'in', user.id),
                ('property_id.subproject_id.user_ids', 'in', user.id),
                ('property_id.subproject_id.property_project_id.user_ids', 'in', user.id),
                ('property_id.property_project_id.user_ids', 'in', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('rental_management.property_rental_officer'))]"/>
        </record>
    </data>
</odoo>