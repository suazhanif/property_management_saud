<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <data noupdate="0">
            <record id="module_rental_management" model="res.groups.privilege">
                <field name="name">Rental Management</field>
                <field name="description">Access rights for Rental Management</field>
            </record>
            <record id="property_rental_officer" model="res.groups">
                <field name="name">Officer</field>
                <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
                <field name="privilege_id" ref="module_rental_management"/>
            </record>
            <record id="property_rental_manager" model="res.groups">
                <field name="name">Manager</field>
                <field name="implied_ids" eval="[(4, ref('property_rental_officer'))]"/>
                <field name="privilege_id" ref="module_rental_management"/>
                <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            </record>
            <record id="property_rental_owner" model="res.groups">
                <field name="name">Owner</field>
                <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
                <field name="privilege_id" ref="module_rental_management"/>
            </record>
            <record id="base.default_user_group" model="res.groups">
                <field name="implied_ids" eval="[(4,ref('rental_management.property_rental_officer'))]"/>
            </record>
        </data>
    </data>
</odoo>
