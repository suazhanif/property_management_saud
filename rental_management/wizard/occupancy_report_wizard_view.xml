<odoo>
    <record id="occupancy_report_wizard_form_view" model="ir.ui.view">
        <field name="name">occupancy.report.wizard.form.view</field>
        <field name="model">occupancy.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_title mb24">
                    <h1>Occupancy Report</h1>
                </div>
                <group string="Filters">
                    <group>
                        <field name="property_project_id" options="{'no_quick_create': True}"/>
                        <field name="subproject_id" options="{'no_quick_create': True}"/>
                        <field name="floor" placeholder="0 = all floors"/>
                    </group>
                    <group>
                        <field name="property_type"/>
                        <field name="stage"/>
                        <field name="only_occupied"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Report"
                            type="object"
                            name="action_generate_report"
                            class="btn btn-primary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancel" special="cancel" class="btn btn-outline-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="occupancy_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Occupancy Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">occupancy.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>