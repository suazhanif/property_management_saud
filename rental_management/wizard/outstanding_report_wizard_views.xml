<odoo>
    <record id="outstanding_report_wizard_form_view" model="ir.ui.view">
        <field name="name">outstanding.report.wizard.form.view</field>
        <field name="model">outstanding.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_title mb24">
                    <h1>Outstanding Report</h1>
                </div>
                <group string="Location">
                    <group>
                        <field name="property_project_id" options="{'no_quick_create': True}"/>
                        <field name="subproject_id" options="{'no_quick_create': True}"/>
                        <field name="floor" placeholder="0 = all floors"/>
                    </group>
                    <group>
                        <field name="property_type"/>
                        <field name="property_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               domain="[('property_project_id', '=?', property_project_id), ('subproject_id', '=?', subproject_id)]"
                               placeholder="All units"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All tenants"/>
                    </group>
                </group>
                <group string="Options">
                    <group>
                        <field name="group_by" widget="radio"/>
                    </group>
                    <group>
                        <field name="invoice_scope" widget="radio"/>
                        <field name="only_overdue"/>
                    </group>
                </group>
                <div class="text-muted small">
                    <b>View</b> opens the list on screen, grouped as selected (switch to Pivot for an aging matrix).
                    <b>Excel</b> downloads Tenant-wise, Unit-wise and Invoice Detail sheets.
                </div>
                <footer>
                    <button string="View" type="object" name="action_view_report"
                            class="btn btn-primary" icon="fa-eye"/>
                    <button string="Excel" type="object" name="action_generate_report"
                            class="btn btn-secondary" icon="fa-file-excel-o"/>
                    <button string="Cancel" special="cancel" class="btn btn-outline-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="outstanding_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Outstanding Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">outstanding.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>